# ── Ключи ─────────────────────────────────────────────────────────────
# Конспект (Claude): https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Расшифровка речи: достаточно одного из ключей.
# Voxtral через OpenRouter: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
# OpenAI (gpt-4o-transcribe-diarize): https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Mistral Voxtral (данные обрабатываются в ЕС): https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# Пароль на вход в приложение. Обязательно задай, если приложение доступно из интернета.
# Логин при входе можно указать любой, проверяется только пароль.
APP_PASSWORD=

# ── Сервер ────────────────────────────────────────────────────────────
# 127.0.0.1 = доступно только с этого компьютера;
# 0.0.0.0 = доступно из сети (тогда обязательно задай APP_PASSWORD и поставь HTTPS).
PORT=3000
HOST=127.0.0.1

# Где хранить записи, расшифровки и конспекты
DATA_DIR=./data

# ── Конспект ──────────────────────────────────────────────────────────
# Язык конспекта по умолчанию: ru | de | en | auto (на языке встречи)
NOTES_LANGUAGE=ru

# Модель Claude и автоконспект выбираются в настройках приложения.
# Насколько глубоко думать: low | medium | high
CLAUDE_EFFORT=medium

# ── Расшифровка ───────────────────────────────────────────────────────
# Кем расшифровывать: openai | mistral | openrouter. Если пусто — тем, чей ключ задан (при обоих — Mistral).
TRANSCRIPTION_PROVIDER=

OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe-diarize
# Для проекта OpenAI с хранением данных в ЕС: https://eu.api.openai.com/v1
OPENAI_BASE_URL=

VOXTRAL_MODEL=voxtral-mini-2602

# ── Прочее ────────────────────────────────────────────────────────────
# Только для docker-compose: домен, на котором будет открываться приложение (для HTTPS)
DOMAIN=

# Путь к ffmpeg. Если пусто, берётся ffmpeg-static из npm или ffmpeg из PATH.
FFMPEG_PATH=
