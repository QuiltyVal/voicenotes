# Ключ Mistral (расшифровка речи, Voxtral): https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# Ключ Anthropic (конспект, Claude): https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Пароль на вход в приложение. Обязательно задай, если приложение доступно из интернета.
# Логин при входе можно указать любой, проверяется только пароль.
APP_PASSWORD=

# Порт и адрес сервера. 127.0.0.1 = доступно только с этого компьютера;
# 0.0.0.0 = доступно из сети (тогда обязательно задай APP_PASSWORD и поставь HTTPS).
PORT=3000
HOST=127.0.0.1

# Где хранить записи, расшифровки и конспекты
DATA_DIR=./data

# Язык конспекта по умолчанию: ru | de | en | auto (на языке встречи)
NOTES_LANGUAGE=ru

# Модель Claude для конспекта. claude-sonnet-5-5 примерно вдвое дешевле.
CLAUDE_MODEL=claude-opus-5-5
# Насколько глубоко думать: low | medium | high
CLAUDE_EFFORT=medium

# Модель Voxtral для расшифровки
VOXTRAL_MODEL=voxtral-mini-2602

# Только для docker-compose: домен, на котором будет открываться приложение (для HTTPS)
DOMAIN=

# Путь к ffmpeg. Если пусто, берётся ffmpeg-static из npm или ffmpeg из PATH.
FFMPEG_PATH=
